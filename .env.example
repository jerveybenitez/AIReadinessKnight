# Copy to .env and fill in.

# Postgres (local install or docker; the app uses @payloadcms/db-postgres only)
DATABASE_URL=postgres://postgres:@127.0.0.1:5432/ai_ready_knight

# Payload admin session secret — use a long random string
PAYLOAD_SECRET=YOUR_SECRET_HERE

# QWEN report endpoint — any OpenAI-compatible chat-completions server.
# Local development default is a localhost server (Ollama, llama.cpp, LM Studio, ...).
# Moving to a hosted endpoint later must be a pure .env change: nothing vendor-specific lives in source.
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=
QWEN_MODEL=qwen2.5

# Set to true for hybrid-reasoning models (qwen3.x) — adds enable_thinking: false so the
# report call doesn't spend its budget on hidden reasoning.
# QWEN_DISABLE_THINKING=true
